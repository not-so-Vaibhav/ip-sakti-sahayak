# IP-SAKTI Sahayak Environment Configuration

# Qdrant Vector Database (assumes 'docker compose up -d' has been run from project root)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ip_sakti_chunks

# Supabase (Postgres & Relational Metadata)
# Run schema_mvp.sql in Supabase SQL editor to initialize tables
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Embeddings (Local sentence-transformers or self-hosted endpoint)
# Local dev default: intfloat/multilingual-e5-base (768-dim, fast on M1/Apple Silicon)
# Production / Demo: intfloat/multilingual-e5-large (1024-dim)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# Dual-Provider LLM Configuration (Works 100% on Free Tiers — at least one key recommended)
# Provider priority: comma-separated list e.g. gemini,groq (or ollama for local dev)
LLM_PROVIDER_PRIORITY=gemini,groq

# Primary Provider: Google Gemini (Free tier via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Fallback Provider: Groq (Free tier via Groq Console: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Local LLM Generation via Ollama (for offline development)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_API_KEY=ollama

# Retrieval & Confidence Tuning Parameters (Configurable, not hardcoded)
CONFIDENCE_THRESHOLD=0.50
HYBRID_DENSE_WEIGHT=0.60
HYBRID_SPARSE_WEIGHT=0.40
TOP_K_RETRIEVAL=8
GENERATION_TIMEOUT_SECONDS=35.0

# Decision Tree Config Path (Relative to backend directory or absolute)
TREE_CONFIG_PATH=config/decision_tree.json
